#!/usr/bin/env bash
#
# pre-push — garde-fou pour un repo PUBLIC provisionne aussi depuis une machine
# de travail. N'AUTORISE QUE l'email noreply GitHub ci-dessous : tout commit
# pousse dont l'auteur OU le committer porte une autre adresse est refuse.
# (Allowlist stricte : attrape gmail, email pro, clone mal configure, etc.)
#
# Activation (une fois par clone, core.hooksPath n'est pas versionne) :
#   git config core.hooksPath .githooks
#
# NB : un hook client est un FILET, pas une garantie (contournable, non applique
# cote serveur). La vraie protection reste l'identite git conditionnelle
# (includeIf) qui evite de creer le mauvais commit en premier lieu.

set -uo pipefail

ALLOWED_EMAIL='142890016+Gdpgt@users.noreply.github.com'
z40='0000000000000000000000000000000000000000'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue          # suppression de branche : rien a scanner
    if [ "$remote_sha" = "$z40" ]; then
        range=("$local_sha" --not --remotes)       # nouvelle branche : commits pas encore sur un remote
    else
        range=("$remote_sha..$local_sha")
    fi

    # emails distincts (auteur + committer) hors de l'allowlist
    bad=$(git log "${range[@]}" --format='%ae%n%ce' 2>/dev/null \
          | sort -u | grep -vixF "$ALLOWED_EMAIL" || true)
    if [ -n "$bad" ]; then
        echo "pre-push REFUSE : email(s) non autorise(s) (attendu uniquement : $ALLOWED_EMAIL)" >&2
        echo "$bad" | sed 's/^/  email interdit : /' >&2
        git log "${range[@]}" --format='%h %ae %s' 2>/dev/null \
            | grep -viF "$ALLOWED_EMAIL" | sed 's/^/    commit : /' >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "  -> Corrige l'identite (git config user.email $ALLOWED_EMAIL) et reecris" >&2
    echo "     ces commits (git rebase / git commit --amend) avant de pousser." >&2
    exit 1
fi
exit 0
